{
  "name": "@qiraa/cli",
  "version": "0.6.4",
  "private": true,
  "type": "module",
  "description": "corpus: command-line access to the Arabic digitization API and search, with credentials in the OS keychain",
  "bin": {
    "corpus": "./src/main.ts"
  },
  "scripts": {
    "build": "bun build src/main.ts --compile --minify --outfile dist/corpus",
    "build:release": "sh scripts/compile.sh",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@qiraa/shared": "workspace:*",
    "@types/bun": "1.4.0",
    "@types/node": "^22.0.0",
    "typescript": "^6.0.3"
  }
}
