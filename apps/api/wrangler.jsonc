/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "arabic-digitization",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-14",
  // Workers Logs. The app writes one evlog wide event per request and per queue
  // message (see src/logging.ts). Invocation logs stay on: they carry
  // $workers.cpuTimeMs, which the wide events can't measure.
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  },
  "upload_source_maps": true,
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "arabic-digitization",
      "database_id": "af0a306c-3617-466c-a6f0-9de1b95e2024",
      "migrations_dir": "./migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "arabic-digitization"
    }
  ],
  // Caches search-highlight results keyed by (fileId, query). The result is
  // deterministic and pages rarely change, so a hit avoids a Claude call.
  "kv_namespaces": [
    {
      "binding": "HIGHLIGHT_CACHE",
      "id": "5d12646d685a452c9880001b031cede8"
    }
  ],
  // max_concurrency caps parallel consumer invocations. Left unset, Cloudflare
  // autoscales to many parallel invocations that each fire an OCR call, which
  // blows past the provider's requests-per-minute quota (the 429 storm). Capped at
  // 2, with the per-message backoff-and-requeue in queue.ts, OCR stays under
  // quota. max_retries is generous so a page can ride out sustained throttling.
  "queues": {
    "producers": [{ "binding": "OCR_Q", "queue": "arabic-ocr" }],
    "consumers": [
      {
        "queue": "arabic-ocr",
        "max_batch_size": 3,
        "max_batch_timeout": 30,
        "max_concurrency": 2,
        "max_retries": 10
      }
    ]
  },
  // Opus review (src/review/): one Workflow instance per Message Batch. It
  // claims pending pages, submits the batch, sleeps between status checks,
  // stores the results in R2 and hands each page to the OCR queue to apply.
  // The cron only starts an instance when pages are waiting.
  "workflows": [
    {
      "name": "opus-review",
      "binding": "REVIEW_WORKFLOW",
      "class_name": "ReviewWorkflow"
    }
  ],
  "triggers": {
    "crons": ["0 */3 * * *"]
  },
  // Meilisearch (hosted on Fly, see infra/meili). MEILI_KEY is a secret:
  // `wrangler secret put MEILI_KEY` (a Meili API key with search + documents.add).
  //
  // CF_AIG_* target the Cloudflare AI Gateway used for Claude: the OCR fallback
  // (see ocr.ts) and search highlighting (see lib/highlight.ts). CF_AIG_TOKEN is
  // a secret (the gateway's cf-aig-authorization token):
  // `wrangler secret put CF_AIG_TOKEN`. The Anthropic key itself is stored in
  // the gateway (BYOK), not here.
  //
  // OLLAMA_API_KEY (Ollama Cloud, for Inkling OCR) is a secret too:
  // `wrangler secret put OLLAMA_API_KEY` (locally: .dev.vars).
  "vars": {
    "MEILI_URL": "https://arabic-digitization-search.fly.dev",
    "CF_AIG_ACCOUNT_ID": "9759ed7a233a1a22e2f01031de0f160a",
    "CF_AIG_GATEWAY": "arabic-digitalization",
    // Base for signed scan links (lib/scanUrl) that providers fetch.
    "PUBLIC_API_URL": "https://arabic-digitization.khan-sufyan-cs.workers.dev"
  }
  /**
   * Smart Placement
   * https://developers.cloudflare.com/workers/configuration/smart-placement/#smart-placement
   */
  // "placement": {  "mode": "smart" }
  /**
   * Bindings
   * Bindings allow your Worker to interact with resources on the Cloudflare Developer Platform, including
   * databases, object storage, AI inference, real-time communication and more.
   * https://developers.cloudflare.com/workers/runtime-apis/bindings/
   */
  /**
   * Environment Variables
   * https://developers.cloudflare.com/workers/wrangler/configuration/#environment-variables
   * Note: Use secrets to store sensitive data.
   * https://developers.cloudflare.com/workers/configuration/secrets/
   */
  // "vars": {  "MY_VARIABLE": "production_value" }
  /**
   * Static Assets
   * https://developers.cloudflare.com/workers/static-assets/binding/
   */
  // "assets": {  "directory": "./public/",  "binding": "ASSETS" }
  /**
   * Service Bindings (communicate between multiple Workers)
   * https://developers.cloudflare.com/workers/wrangler/configuration/#service-bindings
   */
  // "services": [  {   "binding": "MY_SERVICE",   "service": "my-service"  } ]
}
